{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aurum-api",
	"main": "src/index.js",
	"compatibility_date": "2026-06-08",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aurum-db",
			"database_id": "6449c87c-f93f-40b7-b758-4fc1bbe8de2c"
		}
	],
	"triggers": {
		"crons": [
			"0 0 * * *",
			"*/15 * * * *"
		]
	},
	"vars": {
		"ADMIN_USER_IDS": "user_3FUFv9rFInguLcGzl21admhCTHL"
	},
	"kv_namespaces": [
                {
                        "binding": "KV",
                        "id": "fd68faad6a5047d59499c002a0ad2614"
                }
        ],
        "durable_objects": {
                "bindings": [
                        {
                                "name": "CREW_CHAT",
                                "class_name": "CrewChatRoom"
                        }
                ]
        },
        "migrations": [
                {
                        "tag": "v1",
                        "new_sqlite_classes": ["CrewChatRoom"]
                }
        ]
}
